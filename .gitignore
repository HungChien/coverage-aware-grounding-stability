# Python environments and caches
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
*.env

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Private documents and working notes do not belong in the public repository
reports/
paper/
private/
audit/
tmp/
*.docx
*.pdf
*.pptx
*.inspect.ndjson

# Model checkpoints and caches
weights/
*.pt
*.pth
*.onnx
*.ckpt

# Raw datasets. Compact manifests and metadata remain tracked.
data/images/
data/annotations/
data_operational/**/.cache/
data_operational/**/*.jpg
data_operational/**/*.jpeg
data_operational/**/*.png
data_operational/**/*.parquet
data_operational/**/*.tar
data_operational/**/*.tar.gz

# Resume state, logs, and large local traces
**/runtime_tmp/
**/runtime/
**/progress.json
**/sample_traces.jsonl
**/sample_traces.jsonl.gz
**/cap50_traces.jsonl.gz
**/cap50_probe_summary.csv
**/skipped_samples.jsonl
**/*.stdout.log
**/*.stderr.log
**/pipeline.stdout.log
**/pipeline.stderr.log

# Development-only runs
results/*dryrun*/
results/*smoke*/
results/*oom*/
results/*preflight*/
results/*run_logs*/
